<!DOCTYPE html>
<html lang="ja">
<head>
<base target="_top">
<meta charset="utf-8">
<style>
:root{
  --bg:#E9EDF0; --panel:#FFFFFF; --ink:#16212B; --sub:#5B6B79; --line:#D3DAE0;
  --in:#2D7A4C; --out:#B23F2B; --adj:#6F6420; --mute:#A7B2BC;
}
*{box-sizing:border-box}
html,body{margin:0;background:var(--bg);color:var(--ink);
  font-family:"Hiragino Sans","Noto Sans JP","Yu Gothic UI","Meiryo",sans-serif;
  -webkit-tap-highlight-color:transparent}
button,input,select{font:inherit;color:inherit}
button{cursor:pointer}
:focus-visible{outline:3px solid #4A90D9;outline-offset:2px}

/* ヘッダー */
header{position:sticky;top:0;z-index:5;background:var(--ink);color:#fff;padding:10px 12px 8px}
.top{display:flex;gap:8px;align-items:center}
h1{font-size:15px;margin:0;font-weight:700;white-space:nowrap}
#q{flex:1;min-width:0;font-size:18px;padding:10px 12px;border:0;border-radius:8px;background:#fff;color:var(--ink)}
#reload{border:1px solid #ffffff55;background:none;color:#fff;border-radius:8px;padding:9px 10px;font-size:14px}
#reload:disabled{opacity:.4}
.bar{display:flex;gap:6px;margin-top:8px;align-items:center;overflow-x:auto}
.chip{border:1px solid #ffffff55;background:none;color:#fff;padding:5px 12px;border-radius:999px;font-size:14px;white-space:nowrap}
.chip.on{background:#fff;color:var(--ink);border-color:#fff}
#count{margin-left:auto;font-size:13px;color:#C9D3DB;white-space:nowrap}

/* 一覧 */
#list{list-style:none;margin:0;padding:0}
#list li{display:flex;align-items:center;gap:10px;padding:11px 14px;background:var(--panel);border-bottom:1px solid var(--line);cursor:pointer}
#list li:active{background:#F2F5F7}
.hb{font-size:17px;font-weight:700;letter-spacing:.01em;word-break:break-all}
.meta{font-size:13px;color:var(--sub);margin-top:2px}
.qty{margin-left:auto;font-size:30px;font-weight:700;font-variant-numeric:tabular-nums;text-align:right;min-width:2.5ch;line-height:1}
.qty.zero{color:var(--mute)}
.qty.neg{color:var(--out)}
.tag{font-size:12px;font-weight:700;padding:2px 6px;border-radius:4px;margin-left:6px;vertical-align:2px}
.tag.欠品{background:#F6DAD4;color:var(--out)}
.tag.不足{background:#F5E9C8;color:#7A5A00}
.empty{padding:40px 16px;text-align:center;color:var(--sub);cursor:default!important}

/* 登録シート */
#mask{position:fixed;inset:0;background:#0007;opacity:0;pointer-events:none;transition:opacity .15s;z-index:10}
#mask.on{opacity:1;pointer-events:auto}
#sheet{position:fixed;left:0;right:0;bottom:0;z-index:11;background:var(--panel);border-radius:14px 14px 0 0;
  padding:16px 16px calc(16px + env(safe-area-inset-bottom));max-width:640px;margin:0 auto;
  transform:translateY(105%);transition:transform .18s ease-out;max-height:92vh;overflow-y:auto}
#sheet.on{transform:none}
.sh-head{display:flex;gap:12px;align-items:flex-start}
.now{margin-left:auto;text-align:right}
.now b{display:block;font-size:44px;line-height:1;font-variant-numeric:tabular-nums}
.now small{font-size:12px;color:var(--sub)}
.seg{display:grid;grid-template-columns:repeat(3,1fr);gap:6px;margin:16px 0 12px}
.seg button{padding:12px 0;font-size:17px;font-weight:700;border:2px solid var(--line);background:#fff;border-radius:10px;color:var(--sub)}
.seg button.on[data-t="入庫"]{background:var(--in);border-color:var(--in);color:#fff}
.seg button.on[data-t="出庫"]{background:var(--out);border-color:var(--out);color:#fff}
.seg button.on[data-t="調整"]{background:var(--adj);border-color:var(--adj);color:#fff}
.step{display:grid;grid-template-columns:72px 1fr 72px;gap:8px}
.step button{font-size:30px;border:0;border-radius:10px;background:#E4E9ED;height:64px}
#num{font-size:34px;font-weight:700;text-align:center;border:2px solid var(--line);border-radius:10px;width:100%;font-variant-numeric:tabular-nums}
#preview{text-align:center;margin:10px 0 12px;font-size:16px;color:var(--sub);font-variant-numeric:tabular-nums}
#preview.neg{color:var(--out);font-weight:700}
.row2{display:grid;grid-template-columns:110px 1fr;gap:8px}
.row2 select,.row2 input{padding:11px 10px;border:2px solid var(--line);border-radius:10px;background:#fff;font-size:16px;min-width:0}
#save{width:100%;margin-top:12px;padding:16px;border:0;border-radius:10px;font-size:19px;font-weight:700;color:#fff;background:var(--in)}
#sheet[data-t="出庫"] #save{background:var(--out)}
#sheet[data-t="調整"] #save{background:var(--adj)}
#cancel{width:100%;margin-top:6px;padding:10px;border:0;background:none;color:var(--sub);font-size:15px}
details{margin-top:8px;border-top:1px solid var(--line);padding-top:8px}
summary{font-size:14px;color:var(--sub);padding:6px 0}
#hlist{list-style:none;margin:0;padding:0;font-size:14px}
#hlist li{display:grid;grid-template-columns:86px 40px 44px 1fr;gap:6px;padding:6px 0;border-bottom:1px solid #EEF1F3}
#hlist .q{text-align:right;font-variant-numeric:tabular-nums;font-weight:700}

/* トースト */
#toast{position:fixed;left:50%;bottom:24px;transform:translate(-50%,20px);background:var(--ink);color:#fff;padding:10px 16px;
  border-radius:8px;font-size:15px;opacity:0;transition:.2s;z-index:20;max-width:90vw;pointer-events:none}
#toast.on{opacity:1;transform:translate(-50%,0)}
#toast.err{background:var(--out)}
@media (prefers-reduced-motion:reduce){*{transition:none!important}}
</style>
</head>
<body>
<header>
  <div class="top">
    <h1>LIXIL在庫</h1>
    <input id="q" type="search" placeholder="品番で検索（例 3186L）" autocomplete="off">
    <button id="reload" title="最新の在庫を読み込む">更新</button>
  </div>
  <div class="bar" id="chips">
    <button class="chip on" data-f="all">すべて</button>
    <button class="chip" data-f="stock">在庫あり</button>
    <button class="chip" data-f="zero">在庫0</button>
    <button class="chip" data-f="short">不足</button>
    <span id="count"></span>
  </div>
</header>

<ul id="list"></ul>

<div id="mask"></div>
<section id="sheet" data-t="入庫" aria-hidden="true">
  <div class="sh-head">
    <div><div id="sHb" class="hb"></div><div id="sMeta" class="meta"></div></div>
    <div class="now"><b id="sQty"></b><small>現在の在庫</small></div>
  </div>
  <div class="seg" id="seg">
    <button data-t="入庫" class="on">入庫</button>
    <button data-t="出庫">出庫</button>
    <button data-t="調整">調整</button>
  </div>
  <div class="step">
    <button id="minus" aria-label="1減らす">−</button>
    <input id="num" type="number" inputmode="numeric" value="1">
    <button id="plus" aria-label="1増やす">＋</button>
  </div>
  <div id="preview"></div>
  <div class="row2">
    <select id="staff"></select>
    <input id="note" placeholder="備考（現場名など）">
  </div>
  <button id="save">入庫を登録</button>
  <button id="cancel">閉じる</button>
  <details id="hist"><summary>この品番の最近の履歴</summary><ul id="hlist"></ul></details>
</section>

<div id="toast"></div>

<script>
const BOOT = <?!= boot ?>;
const $ = s => document.querySelector(s);
const esc = s => String(s ?? '').replace(/[&<>"]/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;'}[c]));
const norm = s => String(s).replace(/[！-～]/g, c => String.fromCharCode(c.charCodeAt(0) - 0xFEE0))
  .toUpperCase().replace(/[\s\-\/]/g, '');

let items = [], byId = {}, filter = 'all', cur = null, type = '入庫', lastLoad = Date.now();

function prep(list){
  items = list.map(it => (it.key = norm(it.hb + ' ' + it.cat), it));
  byId = {}; items.forEach(it => byId[it.id] = it);
}
function judge(it){
  if (it.stock <= 0) return '欠品';
  if (it.target != null && it.stock < it.target) return '不足';
  return '';
}
function pass(it){
  if (filter === 'stock') return it.stock > 0;
  if (filter === 'zero') return it.stock <= 0;
  if (filter === 'short') return it.target != null && it.stock < it.target;
  return true;
}

function render(){
  const q = norm($('#q').value);
  const rows = items.filter(it => (!q || it.key.includes(q)) && pass(it));
  $('#count').textContent = rows.length + '件';
  $('#list').innerHTML = rows.length ? rows.map(it => {
    const j = judge(it);
    const cls = it.stock < 0 ? 'neg' : it.stock === 0 ? 'zero' : '';
    return `<li data-id="${esc(it.id)}">
      <div><div class="hb">${esc(it.hb)}${j && j !== '欠品' ? `<span class="tag ${j}">${j}</span>` : ''}</div>
      <div class="meta">${esc(it.cat)}　${esc(it.w)}×${esc(it.h)}${it.target != null ? '　適正 ' + it.target : ''}</div></div>
      <div class="qty ${cls}">${it.stock}</div></li>`;
  }).join('') : '<li class="empty">該当する品番がありません。検索語を短くするか、絞り込みを「すべて」にしてください。</li>';
}

/* 登録シート */
function openSheet(it){
  cur = it;
  $('#sHb').textContent = it.hb;
  $('#sMeta').textContent = `${it.cat}　${it.w}×${it.h}`;
  $('#sQty').textContent = it.stock;
  $('#num').value = 1;
  $('#note').value = '';
  $('#hist').open = false;
  $('#hlist').innerHTML = '';
  setType('入庫');
  $('#mask').classList.add('on');
  $('#sheet').classList.add('on');
  $('#sheet').setAttribute('aria-hidden', 'false');
}
function closeSheet(){
  $('#mask').classList.remove('on');
  $('#sheet').classList.remove('on');
  $('#sheet').setAttribute('aria-hidden', 'true');
}
function setType(t){
  type = t;
  document.querySelectorAll('#seg button').forEach(b => b.classList.toggle('on', b.dataset.t === t));
  $('#sheet').dataset.t = t;
  if (t !== '調整' && !(parseInt($('#num').value, 10) >= 1)) $('#num').value = 1;
  update();
}
function delta(){
  const n = parseInt($('#num').value, 10) || 0;
  return type === '出庫' ? -n : n;
}
function update(){
  const after = cur.stock + delta();
  const p = $('#preview');
  p.textContent = `登録後の在庫　${cur.stock} → ${after}`;
  p.classList.toggle('neg', after < 0);
  $('#save').textContent = `${type}を登録`;
}
function step(d){
  const min = type === '調整' ? -9999 : 1;
  $('#num').value = Math.max(min, (parseInt($('#num').value, 10) || 0) + d);
  update();
}

function save(){
  const qty = parseInt($('#num').value, 10);
  if (!qty) return toast('数量を入力してください', true);
  if (type !== '調整' && qty < 1) return toast('入庫・出庫の数量は1以上にしてください', true);
  const it = cur, d = delta(), after = it.stock + d;
  if (after < 0 && !confirm(`在庫が ${after} になります。登録しますか？`)) return;

  const staff = $('#staff').value, note = $('#note').value.trim(), t = type;
  try { localStorage.setItem('zaiko_staff', staff); } catch(e) {}

  // 先に画面へ反映（待ち時間ゼロ）→ 裏でシートへ保存
  it.stock = after;
  closeSheet(); render();
  toast(`${t}を登録中…`);

  google.script.run
    .withSuccessHandler(r => { it.stock = r.stock; render(); toast(`${t}を登録しました　${it.hb}：${r.stock}`); })
    .withFailureHandler(e => { it.stock -= d; render(); toast(`登録できませんでした：${e.message}`, true); })
    .register({ id: it.id, type: t, qty, staff, note });
}

function loadHistory(){
  if (!$('#hist').open || $('#hlist').dataset.id === cur.id) return;
  const id = cur.id;
  $('#hlist').innerHTML = '<li>読み込み中…</li>';
  google.script.run
    .withSuccessHandler(rows => {
      $('#hlist').dataset.id = id;
      $('#hlist').innerHTML = rows.length ? rows.map(r =>
        `<li><span>${esc(r.d)}</span><span>${esc(r.t)}</span><span class="q">${esc(r.q)}</span><span>${esc(r.s)} ${esc(r.n)}</span></li>`
      ).join('') : '<li>この品番の履歴はまだありません</li>';
    })
    .withFailureHandler(e => $('#hlist').innerHTML = `<li>履歴を読み込めませんでした：${esc(e.message)}</li>`)
    .getHistory(id);
}

function reload(silent){
  $('#reload').disabled = true;
  google.script.run
    .withSuccessHandler(d => {
      prep(d); lastLoad = Date.now(); render();
      $('#reload').disabled = false;
      if (!silent) toast('最新の在庫を読み込みました');
    })
    .withFailureHandler(e => { $('#reload').disabled = false; toast(`読み込めませんでした：${e.message}`, true); })
    .getMaster();
}

let tt;
function toast(msg, err){
  const el = $('#toast');
  el.textContent = msg;
  el.classList.toggle('err', !!err);
  el.classList.add('on');
  clearTimeout(tt);
  tt = setTimeout(() => el.classList.remove('on'), err ? 4000 : 2000);
}

/* 初期化 */
prep(BOOT.items);
$('#staff').innerHTML = BOOT.staff.map(s => `<option>${esc(s)}</option>`).join('');
try { const s = localStorage.getItem('zaiko_staff'); if (s && BOOT.staff.includes(s)) $('#staff').value = s; } catch(e) {}
render();

$('#q').addEventListener('input', render);
$('#chips').addEventListener('click', e => {
  const b = e.target.closest('.chip'); if (!b) return;
  filter = b.dataset.f;
  document.querySelectorAll('.chip').forEach(c => c.classList.toggle('on', c === b));
  render();
});
$('#list').addEventListener('click', e => {
  const li = e.target.closest('li[data-id]'); if (li) openSheet(byId[li.dataset.id]);
});
$('#seg').addEventListener('click', e => { const b = e.target.closest('button'); if (b) setType(b.dataset.t); });
$('#minus').addEventListener('click', () => step(-1));
$('#plus').addEventListener('click', () => step(1));
$('#num').addEventListener('input', update);
$('#num').addEventListener('focus', e => e.target.select());
$('#save').addEventListener('click', save);
$('#cancel').addEventListener('click', closeSheet);
$('#mask').addEventListener('click', closeSheet);
$('#hist').addEventListener('toggle', loadHistory);
$('#reload').addEventListener('click', () => reload(false));
document.addEventListener('keydown', e => { if (e.key === 'Escape') closeSheet(); });
document.addEventListener('visibilitychange', () => {
  if (!document.hidden && Date.now() - lastLoad > 60000) reload(true);
});
</script>
</body>
</html>
